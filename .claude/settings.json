{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(.next/**)"
    ],
    "ask": [
      "Edit(lib/supabase/database.types.ts)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-read.sh\"",
            "statusMessage": "Checking for .env access"
          }
        ]
      }
    ]
  }
}
