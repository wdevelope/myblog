## Public (exposed to browser)
NEXT_PUBLIC_API_BASE_URL=
# 메타데이터·sitemap·robots 기준 URL (미설정 시 https://www.w-owen.com)
NEXT_PUBLIC_SITE_URL=

## Supabase (Auth/DB/Storage)
# .env에는 운영(myblog), .env.development.local에는 개발(myblog-dev) 프로젝트 값을 넣는다.
# npm run dev는 .env.development.local을 먼저 읽어 개발 프로젝트에 붙고, npm run build·Vercel은 운영을 쓴다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Server-only (required for admin-only policies / signed URLs)
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron(/api/cron/keep-alive) 인증. Vercel이 Cron 요청에 Bearer로 붙인다
CRON_SECRET=

## Comment notification (server-only, Resend)
# 키나 받는 주소가 없으면 보내지 않는다(개발 서버는 비워 둔다)
RESEND_API_KEY=
COMMENT_NOTIFY_EMAIL=
# 보내는 주소. 비우면 w-life <onboarding@resend.dev>(Resend 가입 주소로만 보낼 수 있다)
COMMENT_NOTIFY_FROM=
